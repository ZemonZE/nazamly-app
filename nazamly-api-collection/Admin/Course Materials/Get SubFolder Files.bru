meta {
  name: Get SubFolder Files (Admin)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/admin/course-materials/:courseCode/files/:subFolderType
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

params:path {
  courseCode: CS316
  subFolderType: lectures
}

docs {
  # [Admin] Get SubFolder Files
  Requires admin role. List files in a specific sub-folder.
  
  ## Path Parameters
  | Param | Description |
  |-------|-------------|
  | courseCode | Course code (e.g. "CS316") |
  | subFolderType | "lectures", "sections", "labs", "exams" |
}
