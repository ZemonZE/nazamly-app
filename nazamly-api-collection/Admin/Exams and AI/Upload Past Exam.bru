meta {
  name: Upload Past Exam
  type: http
  seq: 1
}

post {
  url: {{base_url}}/admin/upload-past-exam
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:multipart-form {
  pdf: @file()
}

docs {
  # [Admin] Upload Past Exam
  Requires admin role. Upload a past exam PDF for archiving.
  Field name: `pdf`.
}
