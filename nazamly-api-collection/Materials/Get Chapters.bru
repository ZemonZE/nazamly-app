get {
  url: {{base_url}}/materials/chapters/:courseInstanceId
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

params:path {
  courseInstanceId: REPLACE_WITH_COURSE_INSTANCE_ID
}

docs {
