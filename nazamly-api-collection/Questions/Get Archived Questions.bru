  token: {{auth_token}}
}

docs {
  # Get Archived Questions (Past Exams)
  
  Returns all archived/past exam questions.
  
  > ⚠️ Requires verified (active) user. Unverified users get `403 EMAIL_NOT_VERIFIED`.
}
