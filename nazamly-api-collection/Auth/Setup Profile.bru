meta {
  name: Setup Profile
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/setup-profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "currentCGPA": 3.15,
    "earnedCreditHours": 125
  }
}

docs {
  # Setup Profile
  
  Updates the user's CGPA and earned credit hours.
  
  ## Body Parameters
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | currentCGPA | number | ✅ | Current CGPA (0.0 - 5.0) |
  | earnedCreditHours | number | ✅ | Total earned credit hours (≥ 0) |
}
