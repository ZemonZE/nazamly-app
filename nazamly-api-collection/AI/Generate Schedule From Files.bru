meta {
  name: Generate Schedule From Files
  type: http
  seq: 1
}

post {
  url: {{base_url}}/ai/generate
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:multipart-form {
  scheduleFiles: @file()
}

docs {
  # AI Generate Schedule From Files
  
  Upload up to 5 schedule image files for AI-powered schedule extraction.
  Rate limited: 5 requests per minute.
  
  Field name: `scheduleFiles`. Accepts multiple image files.
}
