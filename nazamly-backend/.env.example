# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Google Drive - Root folder ID for Nazamly Materials
DRIVE_ROOT_FOLDER_ID=

# Google Drive OAuth2
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REDIRECT_URI=
DRIVE_REFRESH_TOKEN=

# GEMINI API Key (used by backend AI services)
GEMINI_API_KEY=

# Preferred Gemini AI Model Version (defaults to gemini-2.5-flash-lite if unset)
GEMINI_MODEL=gemini-2.5-flash-lite

# Piston code execution service (run via docker-compose)
PISTON_BASE_URL=http://localhost:2000/api/v2